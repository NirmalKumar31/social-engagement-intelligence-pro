      {
        "name": "_Measures",
        "lineageTag": "b582f3ce-9fd6-5634-b599-dc61df992f28",
        "columns": [
          {
            "name": "Measure Holder",
            "dataType": "string",
            "sourceColumn": "Measure Holder",
            "isHidden": true,
            "summarizeBy": "none",
            "lineageTag": "3b533ced-757b-5c75-b275-57ad35f779ea"
          }
        ],
        "measures": [
          {
            "name": "Users",
            "expression": "COUNTROWS(fact_user)",
            "formatString": "#,0",
            "displayFolder": "Experiment",
            "lineageTag": "e2160cdd-3181-5dee-979e-6ae51acd62ea"
          },
          {
            "name": "User-Days",
            "expression": "SUM(fact_daily[users_assigned])",
            "formatString": "#,0",
            "displayFolder": "Engagement",
            "lineageTag": "2b26a598-8ee7-5303-891f-2cd581a46d3d"
          },
          {
            "name": "Minutes per User-Day",
            "expression": "DIVIDE(SUM(fact_daily[minutes]), [User-Days])",
            "formatString": "0.00",
            "displayFolder": "Engagement",
            "lineageTag": "522966d3-58ed-5cb1-94d2-9efd2d23125f"
          },
          {
            "name": "DAU Rate",
            "expression": "DIVIDE(SUM(fact_daily[active_users]), [User-Days])",
            "formatString": "0.0%",
            "displayFolder": "Engagement",
            "lineageTag": "ffd7beb7-1f33-5a7a-84a8-79c53fe21b4c"
          },
          {
            "name": "Sessions per User-Day",
            "expression": "DIVIDE(SUM(fact_daily[sessions]), [User-Days])",
            "formatString": "0.00",
            "displayFolder": "Engagement",
            "lineageTag": "d7da2597-f5f4-5644-820a-5f0f0072e9fa"
          },
          {
            "name": "Friend Interactions per User-Day",
            "expression": "DIVIDE(SUM(fact_daily[friend_interactions]), [User-Days])",
            "formatString": "0.000",
            "displayFolder": "Engagement",
            "lineageTag": "ca9dcd0f-23a1-553b-992b-9444ea63a129"
          },
          {
            "name": "Posts per User-Day",
            "expression": "DIVIDE(SUM(fact_daily[posts_created]), [User-Days])",
            "formatString": "0.000",
            "displayFolder": "Engagement",
            "lineageTag": "f8e1f324-2d46-5c55-b54a-63d1592726d9"
          },
          {
            "name": "Revenue per User-Day",
            "expression": "DIVIDE(SUM(fact_daily[ad_revenue]), [User-Days])",
            "formatString": "$0.0000",
            "displayFolder": "Monetisation",
            "lineageTag": "d870c7fb-07b3-5afb-bb15-ccc6798538c6"
          },
          {
            "name": "Ad CTR",
            "expression": "DIVIDE(SUM(fact_daily[ad_clicks]), SUM(fact_daily[ad_impressions]))",
            "formatString": "0.00%",
            "displayFolder": "Monetisation",
            "lineageTag": "abe24fa6-3f51-590e-b7e3-9a33783e71db"
          },
          {
            "name": "Negative Feedback per 100 Min",
            "expression": "DIVIDE(SUM(fact_daily[negative_feedback]), SUM(fact_daily[minutes])) * 100",
            "formatString": "0.000",
            "displayFolder": "Guardrails",
            "lineageTag": "69339511-db15-57a6-9d05-0897b3023361"
          },
          {
            "name": "Minutes per User-Day (Control)",
            "expression": "CALCULATE([Minutes per User-Day], dim_arm[arm] = \"control\")",
            "formatString": "0.00",
            "displayFolder": "Lift vs Control",
            "lineageTag": "6dc35e46-6b28-532c-afa5-51173dedb466"
          },
          {
            "name": "Minutes Lift vs Control",
            "expression": "DIVIDE([Minutes per User-Day], [Minutes per User-Day (Control)]) - 1",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Lift vs Control",
            "lineageTag": "9eb843a4-bd0b-57b0-b8cc-5c35e5678fd0"
          },
          {
            "name": "Revenue Lift vs Control",
            "expression": "DIVIDE([Revenue per User-Day], CALCULATE([Revenue per User-Day], dim_arm[arm] = \"control\")) - 1",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Lift vs Control",
            "lineageTag": "b36cbe80-a7ef-5bd3-94ca-1fbe6f4a1e71"
          },
          {
            "name": "Friend Interactions Lift vs Control",
            "expression": "DIVIDE([Friend Interactions per User-Day], CALCULATE([Friend Interactions per User-Day], dim_arm[arm] = \"control\")) - 1",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Lift vs Control",
            "lineageTag": "2380d73f-7ce2-5d27-a5ee-198f5c797298"
          },
          {
            "name": "Churn Rate",
            "expression": "AVERAGE(fact_user[churned])",
            "formatString": "0.00%",
            "displayFolder": "Retention",
            "lineageTag": "9c04b676-d5b6-57a7-8997-a8347307550b"
          },
          {
            "name": "Churn Rate (Control)",
            "expression": "CALCULATE([Churn Rate], dim_arm[arm] = \"control\")",
            "formatString": "0.00%",
            "displayFolder": "Retention",
            "lineageTag": "0ee2404e-ce1b-57fb-b43a-97433a16a1c3"
          },
          {
            "name": "Churn Change vs Control (pp)",
            "expression": "([Churn Rate] - [Churn Rate (Control)]) * 100",
            "formatString": "+0.00;-0.00;0.00",
            "displayFolder": "Retention",
            "lineageTag": "f5d704e9-88b9-51b8-b043-d3d954d93a40"
          },
          {
            "name": "Avg Churn Risk",
            "expression": "AVERAGE(fact_user[churn_probability])",
            "formatString": "0.0%",
            "displayFolder": "Retention",
            "lineageTag": "40a96258-4a28-5c72-a40c-caf1081a9c79"
          },
          {
            "name": "High-Risk Users",
            "expression": "CALCULATE(COUNTROWS(fact_user), fact_user[risk_tier] IN {\"High\", \"Critical\"})",
            "formatString": "#,0",
            "displayFolder": "Retention",
            "lineageTag": "01b8de3a-60eb-580b-a778-7abb0f56b637"
          },
          {
            "name": "AI Feed Minutes Lift",
            "expression": "CALCULATE(MAX(metric_results[rel_lift]), metric_results[arm] = \"ai_feed\", metric_results[metric] = \"minutes\")",
            "formatString": "+0.0%;-0.0%",
            "displayFolder": "Headline KPIs",
            "lineageTag": "0406ea0e-8c4c-5e80-b369-51ed45c9fd88"
          },
          {
            "name": "Friend Boost Minutes Lift",
            "expression": "CALCULATE(MAX(metric_results[rel_lift]), metric_results[arm] = \"ai_feed_social\", metric_results[metric] = \"minutes\")",
            "formatString": "+0.0%;-0.0%",
            "displayFolder": "Headline KPIs",
            "lineageTag": "0aca7a3f-a052-55e8-94a2-539aa7fd0a0d"
          },
          {
            "name": "AI Feed Churn Change",
            "expression": "CALCULATE(MAX(metric_results[rel_lift]), metric_results[arm] = \"ai_feed\", metric_results[metric] = \"churned\")",
            "formatString": "+0.0%;-0.0%",
            "displayFolder": "Headline KPIs",
            "lineageTag": "39ea74dc-98ad-580a-aa4f-db249143e73a"
          },
          {
            "name": "Friend Boost Churn Change",
            "expression": "CALCULATE(MAX(metric_results[rel_lift]), metric_results[arm] = \"ai_feed_social\", metric_results[metric] = \"churned\")",
            "formatString": "+0.0%;-0.0%",
            "displayFolder": "Headline KPIs",
            "lineageTag": "fdee091c-bbb7-5f79-9942-cecf43740244"
          },
          {
            "name": "Friend Boost 12M Value ($M)",
            "expression": "CALCULATE(MAX(impact_monte_carlo[p50_musd]), impact_monte_carlo[comparison] = \"AI + friend boost vs control\")",
            "formatString": "$#,0\"M\"",
            "displayFolder": "Headline KPIs",
            "lineageTag": "2a1d0203-3405-5595-a506-e8633ae0aa95"
          },
          {
            "name": "AI Feed 12M Value ($M)",
            "expression": "CALCULATE(MAX(impact_monte_carlo[p50_musd]), impact_monte_carlo[comparison] = \"AI feed vs control\")",
            "formatString": "$#,0\"M\"",
            "displayFolder": "Headline KPIs",
            "lineageTag": "34d3b3fd-4e73-58c1-bd86-aa2e3aeeb15b"
          },
          {
            "name": "P(Friend Boost Beats AI Feed)",
            "expression": "CALCULATE(MAX(impact_monte_carlo[prob_positive]), impact_monte_carlo[comparison] = \"Friend boost minus AI feed\")",
            "formatString": "0.0%",
            "displayFolder": "Headline KPIs",
            "lineageTag": "307c900d-e6bf-5d9f-801c-34d0dc73367b"
          },
          {
            "name": "Significant Wins",
            "expression": "CALCULATE(COUNTROWS(metric_results), metric_results[verdict] = \"win\")",
            "formatString": "0",
            "displayFolder": "Headline KPIs",
            "lineageTag": "aff79733-0bf8-56fa-90f9-4a6bcf4cdf89"
          },
          {
            "name": "Significant Harms",
            "expression": "CALCULATE(COUNTROWS(metric_results), metric_results[verdict] = \"harm\")",
            "formatString": "0",
            "displayFolder": "Headline KPIs",
            "lineageTag": "f2c024e9-ef32-502f-851a-04b709abfe36"
          },
          {
            "name": "Best Policy Uplift ($/user/yr)",
            "expression": "MAX(policy_values[uplift_vs_control_usd])",
            "formatString": "$0.00",
            "displayFolder": "Headline KPIs",
            "lineageTag": "bba268b7-5de5-5e53-bb3f-0da5860663ba"
          },
          {
            "name": "Churn Model AUC",
            "expression": "CALCULATE(MAX(churn_model_metrics[roc_auc]), churn_model_metrics[model] = \"LightGBM + isotonic\")",
            "formatString": "0.000",
            "displayFolder": "Headline KPIs",
            "lineageTag": "18d55ac5-ff22-5fe1-a948-af36dd6ac393"
          }
        ],
